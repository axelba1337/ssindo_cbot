APP_NAME="Neev Solusindo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssindo_cbot
DB_USERNAME=root
DB_PASSWORD=

LLM_PROVIDER=gemini

GEMINI_API_VERSION=v1beta
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.0-flash-001
GEMINI_EMBED_MODEL=models/text-embedding-004

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_STORE=false
OPENAI_WEB_SEARCH=true
OPENAI_WEB_SEARCH_LIVE=true
OPENAI_WEB_SEARCH_CONTEXT=medium

CHATBOT_THRESHOLD=0.45
CHATBOT_LEXICAL_THRESHOLD=0.65
CHATBOT_TOPK=5
CHATBOT_HISTORY_MESSAGES=8
CHATBOT_CTX_ITEMS=3
CHATBOT_CTX_CHARS=2000
CHATBOT_TEMPERATURE=0.2
CHATBOT_LLM_TOPK=40
CHATBOT_LLM_TOPP=0.95
CHATBOT_MAX_TOKENS=512
CHATBOT_HTTP_TIMEOUT=25
CHATBOT_HTTP_RETRY=1
CHATBOT_DEBUG_BADGE=true
CHATBOT_WA_FALLBACK=
CHATBOT_WA_MESSAGE="Halo Neev, saya butuh bantuan."

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
